# ynfight 生产环境配置模板
# 复制为 .env.production 后按需修改（含真实密钥，已 gitignore，勿提交）
#   cp deploy/.env.production.example deploy/.env.production
# compose 通过 --env-file 读取；DATABASE_URL 由 compose 自动拼接，无需在此填写。

# ── 应用 ──────────────────────────────────────────────────────────
DEBUG=false

# ── 数据库口令（首次部署改为强随机值；postgres 容器与 DATABASE_URL 共用）──
# 建议只用字母数字（会拼进 DATABASE_URL，特殊字符需 URL 转义，麻烦）
POSTGRES_PASSWORD=改我-强随机值

# ── CORS ──────────────────────────────────────────────────────────
# 同源部署（FastAPI 托管静态文件）无需跨域，留空即可；
# 若前端与 API 不同源，填允许的地址数组，如 ["https://your-domain.com"]
CORS_ORIGINS=[]

# ── 会话 Cookie ───────────────────────────────────────────────────
# 服务器无 HTTPS 时必须为 false，否则浏览器不发送 Secure Cookie → 登录失效。
# 配置好 HTTPS（反向代理/证书）后改为 true。
AUTH_COOKIE_SECURE=false

# ── Redis ─────────────────────────────────────────────────────────
# 无需配置：docker-compose.prod.yml 自动注入 REDIS_URL=redis://redis:6379/0。
# 事件总线/比对缓存/限流计数/登录锁定/arq 队列共用它；全部可降级，但生产必须部署。

# ── 邮件（密码找回 / 邮箱绑定）──────────────────────────────────────
# console=邮件内容写日志（未配 SMTP 时的占位，找回密码链接会打印在容器日志）；
# smtp=真实发送：免费备用方案用 QQ/163 邮箱——在其网页设置里开启 SMTP 服务并生成"授权码"。
#   QQ： SMTP_HOST=smtp.qq.com  SMTP_PORT=465
#   163：SMTP_HOST=smtp.163.com SMTP_PORT=465
# 注意：EMAIL_FROM 里的邮箱地址必须与 SMTP_USERNAME 完全一致，否则被拒信。
EMAIL_PROVIDER=console
EMAIL_FROM=异闻录 <no-reply@example.com>
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
# 邮件中重置/验证链接指向前端地址：无域名时填 http://<服务器IP>:8102，配好域名后改 https://域名
PUBLIC_FRONTEND_URL=http://<服务器IP>:8102

# ── 可观测性 ───────────────────────────────────────────────────────
# /metrics（Prometheus 指标）默认开启；建议在安全组/反代层限制来源，勿对公网裸奔。
METRICS_ENABLED=true
# 生产结构化 JSON 日志（供腾讯云 CLS 等采集；开发环境保持 false 可读文本）
LOG_JSON=true

# ── 后台任务队列 ───────────────────────────────────────────────────
# inline=进程内执行（默认，够用）；arq=独立 worker 进程（重试+崩溃恢复，
# 需同时去掉 docker-compose.prod.yml 里 worker 服务的注释并重跑 deploy.sh）
TASK_QUEUE_MODE=inline

# ── 数据保留（天数，0=永久保留）────────────────────────────────────
LLM_TRACE_RETENTION_DAYS=90
REQUEST_LOG_RETENTION_DAYS=30

# ── 限流阈值（可选覆盖，默认：登录 5/分、注册 10/分、创建挑战 30/分）──
# RATELIMIT_LOGIN=5/minute
# RATELIMIT_REGISTER=10/minute
# RATELIMIT_CHALLENGE=30/minute

# ── LLM（通义 MaaS，OpenAI 兼容协议）───────────────────────────────
LLM_PROVIDER=openai
LLM_BASE_URL=https://ws-mfxldgdpk6czro89.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=填入你的 API Key
LLM_MODEL=qwen3.7-flash
LLM_MAX_CONCURRENCY=1000

# SECRET_KEY 不进本文件：entrypoint.sh 首次启动自动生成并持久化到卷 /app/data/secret_key

# ── LLM 方案 api_key 加解密密钥（可留空）──────────────────────────────────
# 前端 jsencrypt(RSA) 加密传输 → 后端私钥解密 → Fernet 落库加密；使用时内存解密。
# 留空即首次启动自动生成并持久化到卷 /app/data/llm_profile_keys.json；
# 需固定密钥（多副本/换机）时填真实值，参照 deploy/.env.production 已生成的对应行。
# 更换本组密钥会让既有密文不可解，务必保留原值。
LLM_PROFILE_PRIVATE_KEY=
LLM_PROFILE_STORAGE_KEY=
