# 复制为 .env 后按需修改（模板不含真实密钥）
APP_NAME=异闻录
DEBUG=false

# 数据库（本地 Docker PostgreSQL，见 docker-compose.yml；connector 默认 asyncpg）
# DATABASE_URL=postgresql+asyncpg://ynfight:ynfight@localhost:5432/ynfight
# 备用：SQLite（单文件，本地快速调试）
# DATABASE_URL=sqlite+aiosqlite:///./ynfight.db

# Redis（奇术逐对比对缓存，LRU 淘汰；见 docker-compose.yml）
# REDIS_URL=redis://localhost:6380/0

# JWT 密钥（生产环境必须改为随机值）
SECRET_KEY=dev-secret-change-me

# CORS 允许的前端地址（多个用 JSON 数组）
# CORS_ORIGINS=["http://localhost:5174"]

# LLM 配置（通义 MaaS，OpenAI 兼容协议）
LLM_BASE_URL=https://ws-mfxldgdpk6czro89.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=填入你的 API Key
LLM_MODEL=qwen3.7-flash

# LLM 自配方案的加解密密钥（可选）：不配则自动生成到 app/data/llm_profile_keys.json；
# 生产/Docker 部署建议显式配置（容器重建丢文件会使既有方案密文不可解）。
# PEM 换行写作字面 
（单行）；两个值换新会使已保存方案的 api_key 不可解。
# LLM_PROFILE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----
MII...
-----END PRIVATE KEY-----

# LLM_PROFILE_STORAGE_KEY=<44 字符 Fernet key>

# ── 邮件（密码找回/邮箱验证）──────────────────────────────
# console=邮件内容写日志（开发/测试零配置）；smtp=真实发送（免费备用方案：QQ/163 邮箱 SMTP）
# EMAIL_PROVIDER=console
# EMAIL_FROM=异闻录 <no-reply@example.com>
# 免费备用方案示例（QQ 邮箱）：SMTP_HOST=smtp.qq.com SMTP_PORT=465
#   SMTP_USERNAME=你的QQ邮箱地址  SMTP_PASSWORD=QQ邮箱设置里生成的"授权码"（不是登录密码）
# 163 邮箱同理：SMTP_HOST=smtp.163.com。阿里云邮件推送 DirectMail 走 smtpdm.aliyun.com:465。
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USERNAME=
# SMTP_PASSWORD=
# PUBLIC_FRONTEND_URL=http://localhost:5174

# ── 可观测性 / 后台任务 / 保留策略 ────────────────────────
# METRICS_ENABLED=true
# TASK_QUEUE_MODE=inline
# TASK_QUEUE_MODE=arq   # 需另起：uv run arq app.worker.WorkerSettings
# LLM_TRACE_RETENTION_DAYS=90
# REQUEST_LOG_RETENTION_DAYS=30
