# 复制为 .env 后按需修改（模板不含真实密钥）
APP_NAME=AI 异能大乱斗
DEBUG=true

# 数据库（默认 SQLite）
# DATABASE_URL=sqlite+aiosqlite:///./ynfight.db

# JWT 密钥（生成方式：python -c "import secrets; print(secrets.token_hex(32))"）
SECRET_KEY=dev-secret-change-me

# CORS 允许的前端地址（多个用 JSON 数组）
# CORS_ORIGINS=["http://localhost:5174"]

# LLM 配置（DeepSeek，OpenAI 兼容协议）
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=填入你的 DeepSeek API Key
LLM_MODEL=deepseek-chat
